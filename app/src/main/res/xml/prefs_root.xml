<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/cat_setup">
        <Preference android:key="setup_enable" android:title="@string/setup_enable_title" android:summary="@string/setup_enable_summary" />
        <Preference android:key="setup_select" android:title="@string/setup_select_title" android:summary="@string/setup_select_summary" />
        <Preference android:key="setup_try" android:title="@string/setup_try_title" android:summary="@string/setup_try_summary" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/cat_settings">
        <Preference android:key="screen_languages" android:title="@string/screen_languages" android:summary="@string/screen_languages_summary" app:fragment="com.metrowin.keyboard.settings.LanguagesFragment" />
        <Preference android:key="screen_appearance" android:title="@string/screen_appearance" android:summary="@string/screen_appearance_summary" app:fragment="com.metrowin.keyboard.settings.AppearanceFragment" />
        <Preference android:key="screen_size" android:title="@string/screen_size" android:summary="@string/screen_size_summary" app:fragment="com.metrowin.keyboard.settings.SizeFragment" />
        <Preference android:key="screen_typing" android:title="@string/screen_typing" android:summary="@string/screen_typing_summary" app:fragment="com.metrowin.keyboard.settings.TypingFragment" />
