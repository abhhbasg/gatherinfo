<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ListPreference android:key="gif_source" android:title="@string/pref_gif_source_title" android:entries="@array/gif_source_names" android:entryValues="@array/gif_source_values" android:defaultValue="giphy" app:useSimpleSummaryProvider="true" />
    <EditTextPreference android:key="gif_api_key" android:title="@string/pref_gif_key_title" android:summary="@string/pref_gif_key_summary" android:dialogMessage="@string/pref_gif_key_message" />
    <Preference android:key="gif_folder_pick" android:title="@string/pref_gif_folder_title" android:summary="@string/pref_gif_folder_summary" />
    <PreferenceCategory android:title="@string/cat_gif_custom">
        <EditTextPreference android:key="gif_custom_url" android:title="@string/pref_gif_custom_url_title" android:summary="@string/pref_gif_custom_url_summary" />
        <EditTextPreference android:key="gif_custom_list" android:title="@string/pref_gif_custom_list_title" android:defaultValue="data" app:useSimpleSummaryProvider="true" />
        <EditTextPreference android:key="gif_custom_preview" android:title="@string/pref_gif_custom_preview_title" android:defaultValue="images.fixed_width_small.url" app:useSimpleSummaryProvider="true" />
        <EditTextPreference android:key="gif_custom_full" android:title="@string/pref_gif_custom_full_title" android:defaultValue="images.original.url" app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
    <SwitchPreferenceCompat android:key="gif_link_fallback" android:title="@string/pref_gif_link_title" android:summary="@string/pref_gif_link_summary" android:defaultValue="true" />
</PreferenceScreen>
