<?xml version="1.0" encoding="utf-8"?>
<!-- Page refresh entrance, measured from Microsoft's page-refresh.gif: content rises from +23 % of its
     height to rest over 300 ms on the decelerate curve while its opacity comes up in 83 ms. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <translate android:fromYDelta="23%" android:toYDelta="0" android:duration="300"
        android:interpolator="@interpolator/metro_decelerate" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="83"
        android:interpolator="@android:interpolator/linear" />
</set>
